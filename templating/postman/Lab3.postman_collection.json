{
  "info": {
    "name": "ЛР3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "device_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Список опубликованных устройств",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/smart_devices"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Карточки без статуса\", () => pm.response.json().forEach(d => pm.expect(d).not.to.have.property(\"status\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Фильтр по E(X)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/smart_devices?mean_max=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Фильтр по E(X)\", () => pm.response.json().forEach(d => pm.expect(d.traffic_mean).to.be.at.most(2)));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Создать черновик с изображением и видео",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/smart_devices",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Postman Smart Camera",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Устройство лабораторной 3",
              "type": "text"
            },
            {
              "key": "model",
              "value": "P3",
              "type": "text"
            },
            {
              "key": "type_label",
              "value": "IP-КАМЕРА",
              "type": "text"
            },
            {
              "key": "traffic_mean",
              "value": "8.5",
              "type": "text"
            },
            {
              "key": "traffic_variance",
              "value": "1.25",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "static/img/default.jpg"
            },
            {
              "key": "video",
              "type": "file",
              "src": "static/video/default.mp4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"device_id\", pm.response.json().id);",
              "pm.test(\"Файлы сохранены\", () => { const d = pm.response.json(); pm.expect(d.image_key).to.be.a(\"string\"); pm.expect(d.video_key).to.be.a(\"string\"); pm.expect(d.formed_at).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Получить свой черновик без id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/smart_devices/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Тот же черновик\", () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"device_id\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Опубликовать",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/smart_devices/{{device_id}}/publication",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Дата публикации\", () => pm.expect(pm.response.json().formed_at).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Лента без id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/smart_devices/feed"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Карточка ленты\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Следующая карточка по id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/smart_devices/feed?id={{device_id}}&next=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Следующая карточка\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Поставить лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/smart_devices/{{device_id}}/likes",
        "body": {
          "mode": "raw",
          "raw": "{\"value\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Лайк поставлен\", () => pm.expect(pm.response.json().liked).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Удалить устройство логически",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/smart_devices/{{device_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Пустое тело\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Зарегистрировать пользователя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"lab3_{{$guid}}\", \"password\": \"Lab3-demo-pass!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Без пароля в ответе\", () => { const d = pm.response.json(); pm.expect(d).not.to.have.property(\"password\"); pm.expect(d).not.to.have.property(\"password_hash\"); });"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) { pm.test(\"Ошибка без тела\", () => pm.expect(pm.response.text()).to.eql(\"\")); }",
          "if ([200, 201].includes(pm.response.code) && pm.response.text() && pm.request.url.toString().includes(\"/api/smart_devices\") && !pm.request.url.toString().includes(\"/likes\")) {",
          "  const body = pm.response.json(); const cards = Array.isArray(body) ? body : [body];",
          "  pm.test(\"Одинаковый набор полей карточки\", () => cards.forEach(d => pm.expect(Object.keys(d).sort()).to.eql([\"created_at\", \"creator_id\", \"description\", \"formed_at\", \"id\", \"image_key\", \"is_owner\", \"liked\", \"likes_count\", \"model\", \"title\", \"traffic_mean\", \"traffic_variance\", \"type_label\", \"video_key\"])));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Разрешённый HTTP-код\", () => pm.expect([200, 201, 403, 404]).to.include(pm.response.code));"
        ]
      }
    }
  ]
}
